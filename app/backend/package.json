{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc",
    "deploy": "wrangler deploy",
    "lint": "eslint src --ext .ts --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply lighthouse-db",
    "db:migrate:local": "wrangler d1 migrations apply lighthouse-db --local"
  },
  "dependencies": {
    "hono": "^4.6.3",
    "shared-types": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "drizzle-kit": "^0.25.0",
    "drizzle-orm": "^0.33.0",
    "eslint": "^8.57.1",
    "typescript": "^5.5.4",
    "wrangler": "^3.78.7"
  }
}
